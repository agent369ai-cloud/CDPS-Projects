BACKEND_APP_ENV=development
BACKEND_APP_PORT=8000
# Public web app origin. Outbound emails load Maaden fonts from {FRONTEND_URL}/fonts/maaden/*.ttf
BACKEND_FRONTEND_URL=http://localhost:5173
BACKEND_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/maaden_comms
BACKEND_AUTH_MODE=development
BACKEND_LOCAL_MODE=false
BACKEND_DEV_DEFAULT_USER_ID=u-admin-1
BACKEND_DEV_LOGIN_ENABLED=false
BACKEND_ENTRA_TENANT_ID=
BACKEND_ENTRA_CLIENT_ID=
BACKEND_ENTRA_CLIENT_SECRET=
BACKEND_ENTRA_AUDIENCE=
BACKEND_ENTRA_REDIRECT_URI=http://localhost:8000/api/auth/entra/callback
BACKEND_ENTRA_DISABLE_SIGNATURE_VALIDATION=false
BACKEND_SESSION_SECRET=change-me
BACKEND_SESSION_COOKIE_NAME=maaden_session
BACKEND_SESSION_COOKIE_SECURE=false
BACKEND_SESSION_TTL_MINUTES=480
BACKEND_AZURE_OPENAI_ENABLED=false
BACKEND_AZURE_OPENAI_ENDPOINT=
BACKEND_AZURE_OPENAI_API_KEY=
BACKEND_AZURE_OPENAI_API_VERSION=2024-10-21
BACKEND_AZURE_OPENAI_DEPLOYMENT=

# Microsoft Graph (Azure AD directory + sendMail)
# App Registration with `User.Read.All` (Application) + admin consent.
# Same client credentials are reused by the Add-User-from-Azure-AD flow
# and by the email sender; toggle BACKEND_GRAPH_ENABLED=true to activate.
BACKEND_GRAPH_ENABLED=false
BACKEND_GRAPH_TENANT_ID=
BACKEND_GRAPH_CLIENT_ID=
BACKEND_GRAPH_CLIENT_SECRET=
BACKEND_GRAPH_SENDER_MAILBOX=

# UAT: reroute every outbound email to one distribution list.
# Keep APP_ENV=uat, or leave APP_ENV=production and set FORCE_EMAIL_REROUTE=true.
BACKEND_ADMIN_EMAIL=
BACKEND_FORCE_EMAIL_REROUTE=false
